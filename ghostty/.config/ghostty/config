font-family = EssentialPragmataPro Nerd Font Mono
font-size = 18
font-thicken = false

adjust-cell-height=8%

#custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl

theme = TokyoNight Moon

clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select=clipboard

background-opacity=1.0
background-blur=false
background-blur-radius = 30

macos-option-as-alt = true
#macos-titlebar-proxy-icon = hidden
#macos-titlebar-style = hidden

# Use legacy width method so nerd font icons align with tmux's wcwidth()
#grapheme-width-method = legacy

keybind = shift+enter=text:\n

# Map ctrl + number to prefix keys for tmux window switching
keybind = ctrl+1=text:\x1b1
keybind = ctrl+2=text:\x1b2
keybind = ctrl+3=text:\x1b3
keybind = ctrl+4=text:\x1b4
keybind = ctrl+5=text:\x1b5
keybind = ctrl+6=text:\x1b6
keybind = ctrl+7=text:\x1b7
keybind = ctrl+8=text:\x1b8
keybind = ctrl+9=text:\x1b9
keybind = ctrl+0=text:\x1b0

window-padding-x = 4,4
window-padding-y = 4,4
#window-decoration = none